<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/o_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/o_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OFFENSIVE"
            android:textColor="#FF5B52"
            android:textStyle="bold"
            android:textSize="11sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/o_beast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:maxLines="1"
            android:background="@drawable/widget_beast_chip"
            android:drawableStart="@drawable/ic_beast_bolt"
            android:drawableTint="#08130F"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/o_count"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="0"
        android:textColor="#FF5B52"
        android:textStyle="bold"
        android:textSize="40sp"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/o_atk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF5B52" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:id="@+id/o_atk_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="attack" android:textColor="#94A9A4" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/o_surv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFB300" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:id="@+id/o_surv_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="snoop" android:textColor="#94A9A4" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/o_trk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFD23B" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:id="@+id/o_trk_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="track" android:textColor="#94A9A4" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
